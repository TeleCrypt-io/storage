{
  "name": "@telecrypt-io/storage-web",
  "private": true,
  "version": "0.4.21",
  "license": "BUSL-1.1",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "verify:archive": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-validate-pages-archive.py",
    "verify:release": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/test-release-ui-workflow.py",
    "verify:package": "bash scripts/verify-pages-package.sh",
    "verify:security": "node scripts/verify-security-policy.mjs && node scripts/test-storage-sdk-lock.mjs && bash -n scripts/verify-shared-ui-release.sh && node scripts/verify-provenance.mjs && node scripts/test-provenance.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@telecrypt-io/storage": "0.6.1",
    "buffer": "6.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "29.1.1",
    "oxlint": "1.79.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
